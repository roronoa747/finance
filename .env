# Адрес проекта и ПУБЛИЧНЫЙ ключ Supabase.
#
# Этот ключ не секрет: Vite вшивает переменные VITE_* прямо в бандл, поэтому он
# в любом случае виден каждому, кто откроет сайт и посмотрит исходники страницы.
# Данные защищает не он, а права доступа в базе — без входа и без кода
# приглашения с ним ничего не сделать.
#
# Настоящие секреты (service_role, ключи платных сервисов) сюда класть нельзя
# никогда. Для них — .env.local, который в репозиторий не уходит.

VITE_SUPABASE_URL=https://tpkyopaovfdkcmdhauws.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_UbzcoBiOEPxvztoz6S7JtQ_5jCkj18r
